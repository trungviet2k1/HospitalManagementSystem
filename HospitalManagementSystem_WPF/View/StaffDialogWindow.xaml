<Window x:Class="HospitalManagementSystem_WPF.View.StaffDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HospitalManagementSystem_WPF"
        Title="Staff" Height="420" Width="450" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F5F5">

    <Window.Resources>
        <local:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Border CornerRadius="10" Padding="20" Background="White" BorderBrush="#DDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Username -->
                <RowDefinition Height="Auto"/>
                <!-- Password -->
                <RowDefinition Height="Auto"/>
                <!-- Full Name -->
                <RowDefinition Height="Auto"/>
                <!-- Email -->
                <RowDefinition Height="Auto"/>
                <!-- Phone -->
                <RowDefinition Height="Auto"/>
                <!-- Role -->
                <RowDefinition Height="Auto"/>
                <!-- Department -->
                <RowDefinition Height="Auto"/>
                <!-- Status -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Username -->
            <TextBlock Text="Username:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Text="{Binding User.Username, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Margin="5" Padding="5"/>

            <!-- Password -->
            <TextBlock Text="Password:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="5" Padding="5"/>

            <!-- Full Name -->
            <TextBlock Text="Full Name:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Text="{Binding User.FullName, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" Margin="5" Padding="5"/>

            <!-- Email -->
            <TextBlock Text="Email:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Email:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="5">
                <TextBox x:Name="EmailPrefixTextBox" Width="180" Text="{Binding EmailPrefix, Mode=TwoWay}" Padding="5"/>
                <TextBlock Text="@hsm.com" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Phone -->
            <TextBlock Text="Phone:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Text="{Binding User.PhoneNumber, Mode=TwoWay}" Grid.Row="4" Grid.Column="1" Margin="5" Padding="5"/>

            <!-- Role -->
            <TextBlock Text="Role:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="RoleComboBox"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                      DisplayMemberPath="RoleName"
                      Grid.Row="5" Grid.Column="1" Margin="5" Padding="5" Width="250"/>

            <!-- Department -->
            <TextBlock Text="Department:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="DepartmentComboBox"
                      ItemsSource="{Binding Departments}"
                      SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"
                      DisplayMemberPath="DepartmentName"
                      Grid.Row="6" Grid.Column="1" Margin="5" Padding="5" Width="250"/>

            <!-- Status -->
            <TextBlock Text="Status:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1" Margin="5" VerticalAlignment="Center">
                <RadioButton Content="Active" IsChecked="{Binding User.Status, Mode=TwoWay}" Margin="0,0,10,0"/>
                <RadioButton Content="Inactive" IsChecked="{Binding User.Status, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="OK" Width="90" Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold" IsDefault="True" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="90" Margin="5" Background="#F44336" Foreground="White" FontWeight="Bold" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>