<Window x:Class="HospitalManagementSystem_WPF.View.PermissionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permissions" Height="400" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <ListBox ItemsSource="{Binding Permissions}" SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding PermissionName}" IsChecked="{Binding IsAssigned, Mode=TwoWay}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="5" Command="{Binding SaveCommand}"/>
            <Button Content="Close" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>