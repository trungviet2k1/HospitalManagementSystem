<UserControl x:Class="HospitalManagementSystem_WPF.View.NoPermissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="300" Width="500">

    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Resources/warning.png" Width="64" Height="64" Margin="0,0,0,20"/>
            <TextBlock Text="⚠️ KHÔNG CÓ QUYỀN TRUY CẬP" 
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,20"
                       Foreground="Red"/>

            <TextBlock Text="Tài khoản của bạn không có quyền thao tác trên hệ thống."
                       TextWrapping="Wrap" Width="300" TextAlignment="Center"/>
            <TextBlock Text="Vui lòng liên hệ quản trị viên để được cấp quyền phù hợp."
                       TextWrapping="Wrap" Width="300" TextAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Command sẽ binding tới MainViewModel -->
                <Button Content="Liên hệ Admin" Command="{Binding ContactAdminCommand}" 
                        Margin="5" Width="120" Background="#2196F3" Foreground="White"/>
                <Button Content="Đăng xuất" Command="{Binding LogoutCommand}" 
                        Margin="5" Width="120" Background="#F44336" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>