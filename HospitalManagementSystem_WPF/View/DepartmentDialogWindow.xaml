<Window x:Class="HospitalManagementSystem_WPF.View.DepartmentDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Department Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Department Name:"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="5,5,0,5"
                 Text="{Binding Department.DepartmentName, UpdateSourceTrigger=PropertyChanged}"
                 Height="25" />

        <!-- Location -->
        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0" Text="Location:"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5,10,0,5"
                 Text="{Binding Department.Location, UpdateSourceTrigger=PropertyChanged}"
                 Height="25" />

        <!-- Department Head -->
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0" Text="Department Head:"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="5,10,0,5" Height="25"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding Department.DepartmentHead, Mode=TwoWay}"
                  DisplayMemberPath="FullName"
                  IsEditable="False"
                  />

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="70" Height="20" Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="70" Height="20" Margin="5" Background="#F44336" Foreground="White" FontWeight="Bold" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>