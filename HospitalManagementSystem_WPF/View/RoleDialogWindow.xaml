<Window x:Class="HospitalManagementSystem_WPF.View.RoleDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Roles" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Style cho tất cả các nút -->
        <Style TargetType="Button" x:Key="RoundedButtonStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Role Name -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Width="100" Text="Role Name:"/>
            <TextBox Width="200" Text="{Binding SelectedRole.RoleName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- List of Roles -->
        <ListView Grid.Row="1" ItemsSource="{Binding RoleList}" SelectedItem="{Binding SelectedRole}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Role ID" DisplayMemberBinding="{Binding RoleId}" Width="50"/>
                    <GridViewColumn Header="Role Name" DisplayMemberBinding="{Binding RoleName}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Add" Width="60" Margin="5" Command="{Binding AddCommand}" Background="#4CAF50"
            Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="Edit" Width="60" Margin="5" Command="{Binding EditCommand}" Background="#FFC107"
            Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="Delete" Width="60" Margin="5" Command="{Binding DeleteCommand}" Background="#F44336"
            Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="New Permission" Width="120" Margin="5" Command="{Binding NewPermissionCommand}" Background="#2196F3"
            Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="View Permissions" Width="120" Margin="5" Command="{Binding ViewPermissionCommand}" Background="#9C27B0"
            Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="Close" Width="60" Margin="5" IsCancel="True" Background="#607D8B"
            Style="{StaticResource RoundedButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>