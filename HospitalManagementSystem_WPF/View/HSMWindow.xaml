<Window x:Class="HospitalManagementSystem_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalManagementSystem_WPF"
        xmlns:views="clr-namespace:HospitalManagementSystem_WPF.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Hospital Management System - HMY" Height="450" Width="800">

    <Window.Resources>
        <!-- Converter dùng lại ở nhiều nơi -->
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <local:UserGreetingConverter x:Key="UserGreetingConverter"/>

        <ContextMenu x:Key="PatientContextMenu">
            <MenuItem Header="Xem lịch hẹn" 
              Command="{Binding CurrentViewModel.ViewPatientAppointmentsCommand}"/>
            <MenuItem Header="Đặt lịch hẹn mới" 
              Command="{Binding CurrentViewModel.ScheduleAppointmentCommand}"/>
            <Separator/>
            <MenuItem Header="Refresh" 
              Command="{Binding CurrentViewModel.LoadPatientsCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="AppointmentContextMenu">
            <MenuItem Header="Xem thông tin bệnh nhân" 
              Command="{Binding CurrentViewModel.ViewPatientDetailsCommand}"/>
            <Separator/>
            <MenuItem Header="Refresh" 
              Command="{Binding CurrentViewModel.LoadAppointmentsCommand}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <!-- Hiển thị NoPermissionView nếu không có permission -->
        <views:NoPermissionView
            Visibility="{Binding HasPermission, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>

        <!-- Hiển thị nội dung chính nếu có permission -->
        <Grid Visibility="{Binding HasPermission, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Greeting -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Greeting -->
                <TextBlock Grid.Column="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontWeight="Bold" FontSize="14"
                   Text="{Binding CurrentUser, Converter={StaticResource UserGreetingConverter}}"/>

                <!-- New Role button -->
                <Button Grid.Column="1"
                        Content="New Role"
                        Width="100"
                        Height="30"
                        Margin="10,0,0,0"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding NewRoleCommand}"
                        Visibility="{Binding NewRoleButtonVisibility}"/>
            </Grid>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Tab for Staff -->
                <TabItem Header="Staff" Visibility="{Binding StaffTabVisibility}">
                    <ListView Margin="10" 
                              ItemsSource="{Binding CurrentViewModel.StaffList, FallbackValue={x:Null}}"
                              SelectedItem="{Binding CurrentViewModel.SelectedStaff}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding UserId}" Width="50"/>
                                <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" Width="150"/>
                                <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding FullName}" Width="200"/>
                                <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="200"/>
                                <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding PhoneNumber}" Width="150"/>
                                <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role.RoleName}" Width="150"/>
                                <GridViewColumn Header="Working department" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DepartmentName}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Dùng Converter thay vì raw bool -->
                                <GridViewColumn Header="Status" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource BooleanToStatusConverter}, ConverterParameter=User}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <!-- Tab for Departments -->
                <TabItem Header="Departments" Visibility="{Binding DepartmentTabVisibility}">
                    <ListView Margin="10" 
                              ItemsSource="{Binding CurrentViewModel.DepartmentList, FallbackValue={x:Null}}"
                              SelectedItem="{Binding CurrentViewModel.SelectedDepartment, Mode=TwoWay}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding DepartmentId}" Width="50"/>
                                <GridViewColumn Header="Department Name" DisplayMemberBinding="{Binding DepartmentName}" Width="200"/>
                                <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="150"/>
                                <GridViewColumn Header="Head" DisplayMemberBinding="{Binding DepartmentHead.FullName}" Width="150"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <!-- Tab for Rooms -->
                <TabItem Header="Rooms" Visibility="{Binding RoomTabVisibility}">
                    <ListView Margin="10" ItemsSource="{Binding CurrentViewModel.RoomList, FallbackValue={x:Null}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Room Number" DisplayMemberBinding="{Binding RoomNumber}" Width="100"/>
                                <GridViewColumn Header="Department" DisplayMemberBinding="{Binding Department.DepartmentName}" Width="200"/>

                                <!-- Availability hiển thị bằng Converter -->
                                <GridViewColumn Header="Availability" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsAvailable, Converter={StaticResource BooleanToStatusConverter}, ConverterParameter=Room}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <!-- Tab for Patients -->
                <TabItem Header="Patients" Visibility="{Binding PatientTabVisibility}">
                    <ListView Margin="10"
                              ItemsSource="{Binding CurrentViewModel.PatientList, FallbackValue={x:Null}}"
                              SelectedItem="{Binding CurrentViewModel.SelectedPatient, Mode=TwoWay}"
                              ContextMenu="{StaticResource PatientContextMenu}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding FullName}" Width="150"/>
                                <GridViewColumn Header="Date of Birth" DisplayMemberBinding="{Binding DateOfBirth, StringFormat=d}" Width="100"/>
                                <GridViewColumn Header="Gender" DisplayMemberBinding="{Binding Gender}" Width="80"/>
                                <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="160"/>
                                <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding PhoneNumber}" Width="120"/>

                                <!-- Doctor in charge column - Hiển thị FullName -->
                                <GridViewColumn Header="Doctor in charge" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Doctor.FullName, FallbackValue='Not assigned'}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Status column -->
                                <GridViewColumn Header="Status" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource BooleanToStatusConverter}, ConverterParameter=Patient}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <!-- Tab for Appointments -->
                <TabItem Header="Appointments" Visibility="{Binding AppointmentTabVisibility}">
                    <ListView Margin="10"
                              ItemsSource="{Binding CurrentViewModel.AppointmentList, FallbackValue={x:Null}}"
                              SelectedItem="{Binding CurrentViewModel.SelectedAppointment, Mode=TwoWay}"
                              ContextMenu="{StaticResource AppointmentContextMenu}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding Patient.FullName}" Width="150"/>
                                <GridViewColumn Header="Doctor" DisplayMemberBinding="{Binding Doctor.FullName}" Width="150"/>
                                <GridViewColumn Header="Appointment Date" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AppointmentDate, StringFormat='dd/MM/yyyy HH:mm'}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <!-- Tab for Medications -->
                <TabItem Header="Medications" Visibility="{Binding MedicationTabVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <!-- Danh sách thuốc -->
                        <ListView Grid.Row="0" Margin="10" 
                  ItemsSource="{Binding CurrentViewModel.MedicationList, FallbackValue={x:Null}}"
                  SelectedItem="{Binding CurrentViewModel.SelectedMedication, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding MedicationId}" Width="50"/>
                                    <GridViewColumn Header="Tên thuốc" DisplayMemberBinding="{Binding MedicationName}" Width="200"/>
                                    <GridViewColumn Header="Số lượng" DisplayMemberBinding="{Binding QuantityInStock}" Width="80"/>
                                    <GridViewColumn Header="Đơn vị" DisplayMemberBinding="{Binding Unit}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Thông tin tồn kho -->
                        <GroupBox Grid.Row="1" Header="Thông tin tồn kho" Margin="10">
                            <DataGrid ItemsSource="{Binding CurrentViewModel.Inventories}" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding InventoryId}" Width="50"/>
                                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="80"/>
                                    <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="150"/>
                                    <DataGridTextColumn Header="Cập nhật" Binding="{Binding LastUpdated, StringFormat='dd/MM/yyyy HH:mm'}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- Tab for Invoices -->
                <TabItem Header="Invoices" Visibility="{Binding InvoiceTabVisibility}">
                    <TextBlock Text="Invoice data will be displayed here" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </TabItem>

                <!-- Tab for Logout -->
                <TabItem>
                    <TabItem.Header>
                        <Button Content="Logout" Command="{Binding LogoutCommand}"
                                Background="Transparent" BorderThickness="0"/>
                    </TabItem.Header>
                </TabItem>
            </TabControl>

            <!-- Buttons for Admin actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Add" Width="100" Height="40" Margin="5" Background="#4CAF50" 
                        Foreground="White" FontWeight="Bold" Command="{Binding AddCommand}" 
                        Visibility="{Binding AddButtonVisibility}"/>
                <Button Content="Edit" Width="100" Height="40" Margin="5" Background="#FFC107" 
                        Foreground="White" FontWeight="Bold" Command="{Binding EditCommand}" 
                        Visibility="{Binding EditButtonVisibility}"/>
                <Button Content="Delete" Width="100" Height="40" Margin="5" Background="#F44336" 
                        Foreground="White" FontWeight="Bold" Command="{Binding DeleteCommand}" 
                        Visibility="{Binding DeleteButtonVisibility}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>