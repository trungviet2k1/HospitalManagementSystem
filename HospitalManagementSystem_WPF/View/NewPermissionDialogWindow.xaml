<Window x:Class="HospitalManagementSystem_WPF.View.NewPermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Permission" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Input mới -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons Add/Save -->
            <RowDefinition Height="*"/>
            <!-- List of Permissions -->
        </Grid.RowDefinitions>

        <!-- Thêm mới permission -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Width="120" Text="Permission Name:"/>
            <TextBox Width="200" Text="{Binding PermissionName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Buttons Add và Cancel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Add" Width="80" Margin="5" Command="{Binding AddPermissionCommand}"/>
            <Button Content="Close" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>

        <!-- Danh sách permission -->
        <ListView Grid.Row="2" ItemsSource="{Binding PermissionList}" SelectedItem="{Binding SelectedPermission}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding PermissionId}" Width="50"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding PermissionName}" Width="200"/>

                    <!-- Action column: Edit + Delete -->
                    <GridViewColumn Header="Action" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Edit button -->
                                    <Button Content="Edit" Width="70" Height="25"
                                            Background="#FFC107" Foreground="White" FontWeight="Bold"
                                            Margin="0,0,5,0"
                                            Command="{Binding DataContext.EditPermissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Delete button -->
                                    <Button Content="Delete" Width="70" Height="25"
                                            Background="#F44336" Foreground="White" FontWeight="Bold"
                                            Command="{Binding DataContext.DeletePermissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>