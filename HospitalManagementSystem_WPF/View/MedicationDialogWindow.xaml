<Window x:Class="HospitalManagementSystem_WPF.MedicationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalManagementSystem_WPF"
        mc:Ignorable="d"
        Title="Quản lý Thuốc" Height="450" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Form nhập thông tin thuốc -->
        <GroupBox Grid.Row="0" Header="Thông tin thuốc" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên thuốc:" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MedicationName}" Margin="5" Height="25"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Số lượng:" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding QuantityInStock}" Margin="5" Height="25"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đơn vị:" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Unit}" Margin="5" Height="25"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Vị trí kho:" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Location}" Margin="5" Height="25"/>
            </Grid>
        </GroupBox>

        <!-- Danh sách inventory -->
        <GroupBox Grid.Row="1" Header="Lịch sử tồn kho" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Inventories}" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding InventoryId}" Width="50"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="Ngày cập nhật" Binding="{Binding LastUpdated, StringFormat='dd/MM/yyyy HH:mm'}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Nút điều khiển -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Lưu" Width="80" Height="30" Margin="5" 
                    Command="{Binding SaveCommand}" Background="#4CAF50" Foreground="White"/>
            <Button Content="Hủy" Width="80" Height="30" Margin="5" 
                    Click="CancelButton_Click" Background="#F44336" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>