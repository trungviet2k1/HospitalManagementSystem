<Window x:Class="HospitalManagementSystem_WPF.View.PatientDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HospitalManagementSystem_WPF"
        Title="Patient Details" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f5f5">

    <Window.Resources>
        <conv:GenderToBoolConverter x:Key="GenderToBoolConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="White" Padding="20" Margin="10" BorderBrush="#ddd" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Form Grid -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Doctor row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Status row -->
                </Grid.RowDefinitions>

                <TextBlock Text="Full Name:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                <TextBox Text="{Binding Patient.FullName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="Date of Birth:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                <DatePicker SelectedDate="{Binding Patient.DateOfBirth, Mode=TwoWay}" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Gender:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
                    <RadioButton Content="Male"
                                 IsChecked="{Binding Patient.Gender, Converter={StaticResource GenderToBoolConverter}, ConverterParameter=Male, Mode=TwoWay}"/>
                    <RadioButton Content="Female" Margin="20,0,0,0"
                                 IsChecked="{Binding Patient.Gender, Converter={StaticResource GenderToBoolConverter}, ConverterParameter=Female, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Text="Address:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
                <TextBox Text="{Binding Patient.Address}" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Phone Number:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0"/>
                <TextBox Text="{Binding Patient.PhoneNumber}" Grid.Row="4" Grid.Column="1"/>

                <TextBlock Text="Doctor:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0"/>
                <ComboBox Grid.Row="5" Grid.Column="1"
                          ItemsSource="{Binding AvailableDoctors}"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="UserId"
                          SelectedValue="{Binding Patient.DoctorId}"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Status:" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0"/>
                <CheckBox IsChecked="{Binding Patient.Status}" Grid.Row="6" Grid.Column="1"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Background="#4CAF50" Foreground="White" IsDefault="True" Command="{Binding OkCommand}"/>
                <Button Content="Cancel" Background="#F44336" Foreground="White" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>